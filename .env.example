# ─────────────────────────────────────────────────────────────
# Site Kaleidos — variáveis de ambiente
# Copie pra .env.local e preencha. NUNCA commitar .env.local.
# Vars NEXT_PUBLIC_* são expostas no client (analytics/SEO).
# ─────────────────────────────────────────────────────────────

# ── Analytics / Tracking ────────────────────────────────────

# PostHog (obrigatório p/ product analytics + origem de tráfego).
# Project "Kaleidos Group" (id 387434). Eventos passam pelo proxy /ingest
# (rewrite no next.config.ts) pra furar adblock.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Host só usado pelo client server-side (posthog-node). Default us cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (opcional, mas recomendado p/ canais de aquisição GA).
# Pegue em analytics.google.com → Admin → Data Streams → Measurement ID.
# Formato: G-XXXXXXXXXX. Sem isso, o GA4 simplesmente não carrega (no-op).
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity (heatmaps + session replay).
# A rota /2 (web3v2) SÓ carrega o Clarity quando esta var estiver setada —
# sem ID, o script não é injetado (nenhum default inventado).
# PASSO A PASSO (Gabriel): 1) crie um projeto em https://clarity.microsoft.com
# 2) copie o Project ID (Settings -> Overview, ex.: "abcd1234ef")
# 3) cole aqui no .env.local E adicione na Vercel (Production + Preview).
# O componente legado src/components/clarity.tsx tem um default antigo
# (u6iptqredj) que NAO e usado na rota /2.
NEXT_PUBLIC_CLARITY_ID=

# Meta Pixel (Facebook/Instagram ads). Sem isso o Pixel fica silencioso.
NEXT_PUBLIC_META_PIXEL_ID=

# ── SEO / Metadata ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://kaleidos.com.br
NEXT_PUBLIC_SITE_NAME=Kaleidos Digital
NEXT_PUBLIC_TWITTER_HANDLE=@digitalkaleidos
NEXT_PUBLIC_SITE_KEYWORDS=

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Kaleidos <noreply@kaleidos.com.br>
# Audience de inscritos da newsletter (blog/papers gate).
RESEND_AUDIENCE_ID=
# Audience de leads do diagnóstico de IA (form lead-ia).
RESEND_AUDIENCE_ID_LEADS=

# ── Auth painel /app ────────────────────────────────────────
# Obrigatória em prod. Sem ela o middleware responde 401 (fail-closed).
# NUNCA reutilizar senha que já vazou no git (histórico). Rotacionar se suspeita.
APP_DASHBOARD_PASSWORD=

# ── Cron (Vercel Cron → /api/cron/lead-email-sequence) ──────
# Authorization: Bearer $CRON_SECRET (único método aceito pelo route).
CRON_SECRET=

# ── Leads / DB / rate limit ─────────────────────────────────
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# HMAC do unsubscribe. Em prod NÃO deixe cair no fallback da Resend key.
# Gere: openssl rand -hex 32
LEAD_UNSUB_SECRET=
LEAD_NOTIFICATION_TO=
LEAD_NOTIFICATION_CC=
LEAD_SEQUENCE_FROM=Kaleidos <noreply@kaleidos.com.br>
LEAD_SEQUENCE_REPLY_TO=

# ── JSON-LD org (opcional) ──────────────────────────────────
NEXT_PUBLIC_KALEIDOS_PHONE=+5512997796835
NEXT_PUBLIC_KALEIDOS_TAX_ID=
NEXT_PUBLIC_KALEIDOS_STREET=
NEXT_PUBLIC_KALEIDOS_POSTAL_CODE=

# Policy papers (GEO): PDFs e /papers/*/read.html são públicos de propósito
# para citação em LLMs. O gate/popup captura email pra UX + lista Resend —
# não é DRM. Ver docs/AUDITORIA-SITE-2026-07-14.md.
